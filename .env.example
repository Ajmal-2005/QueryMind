# Copy to .env and fill in. Never commit the real .env.

# --- application ---
ENVIRONMENT=development
DEBUG=true

# --- app database ---
# Local (no Docker) default: SQLite, requires nothing.
DATABASE_URL=sqlite+pysqlite:///./nlq_app.db
# With Docker Compose, use Postgres instead:
# DATABASE_URL=postgresql+psycopg://nlq:nlq_dev_password@localhost:5432/nlq_app

# --- cache (optional in phase 0) ---
# REDIS_URL=redis://localhost:6379/0

# --- security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Fernet key encrypting stored target-database credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- llm providers (needed from phase 2) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- execution guardrails ---
QUERY_TIMEOUT_SECONDS=30
MAX_RESULT_ROWS=10000
MAX_CORRECTION_ATTEMPTS=3
